# LLM 配置（任意 OpenAI 兼容端点；默认阿里云百炼）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=qwen3.8-flash

# Google Health API（console.cloud.google.com 建OAuth 客户端获取，见 docs/google-health-spike.md）
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# 访问 Google 需代理时填写，如 http://127.0.0.1:7897
GOOGLE_PROXY=
# 回调地址（需与 GCP OAuth 客户端里登记的一致），默认 http://localhost:3000/api/google/callback
# GOOGLE_REDIRECT_URI=
# 训记 App Open API(训练记录来源),Key 在训记 App 内申请
XUNJI_API_KEY=your-xunji-api-key
# 自动同步间隔分钟数，0 = 关闭
# GOOGLE_SYNC_INTERVAL_MINUTES=60

# 登录认证(单用户)。AUTH_PASSWORD_HASH 生成方式(分隔符必须用 : 不能用 $,
# 否则 Next 加载 env 时 $xxx 会被 dotenv-expand 当变量引用展开成空串):
#   node -e "const c=require('node:crypto');const s=c.randomBytes(16);console.log('scrypt:'+s.toString('hex')+':'+c.scryptSync('你的密码',s,64).toString('hex'))"
AUTH_PASSWORD_HASH=
# 会话签名密钥(随机生成即可):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

